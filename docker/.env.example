# Copy to `.env` in this directory and fill in. `.env` is gitignored and must never be
# committed — it holds real credentials.
#
#   cp .env.example .env
#
# Nothing here has a working default on purpose. The application and PostgreSQL both refuse
# to start without a password rather than falling back to a blank or well-known one.

# ---------------------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------------------
# Generate something long and random, e.g.:
#   openssl rand -base64 36
NOVOCORE_DB_PASSWORD=

# Optional; the defaults are fine for local development.
# NOVOCORE_DB_NAME=novocore
# NOVOCORE_DB_USER=novocore

# ---------------------------------------------------------------------------------------
# First login
# ---------------------------------------------------------------------------------------
# The initial Owner account. Used ONCE, on the first start against an empty user table.
#
# There is deliberately no seeded default account and no default password: the application
# refuses to start on an empty user table without these, rather than shipping an admin/admin
# that outlives every intention to change it.
#
# Minimum password length is 12 characters. Generate one, e.g.:
#   openssl rand -base64 24
#
# Once the first owner exists these are ignored, and should be removed from this file —
# changing the password in the application will not update them.
NOVOCORE_BOOTSTRAP_OWNER_USERNAME=
NOVOCORE_BOOTSTRAP_OWNER_PASSWORD=

# ---------------------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------------------
# The SMTP password, used ONCE, on the first start where none is stored yet.
#
# Everything else email needs — host, port, transport security, sender address, Reply-To —
# is seeded by migration V20 and lives in Settings. The password lives in Settings too;
# this variable is only how it gets there the first time, because a migration is a file in
# git and a credential in git is in git permanently.
#
# Unlike the owner password above, leaving this empty does NOT stop the application. Email
# queues and does not send, the reason is logged, and the outbox holds what is waiting.
#
# Once it has been stored, this is ignored and should be removed from this file — changing
# the password in Settings will not update it, and editing it here will not change Settings.
NOVOCORE_SMTP_PASSWORD=

# ---------------------------------------------------------------------------------------
# Hostname / TLS
# ---------------------------------------------------------------------------------------
# Local development: leave as `localhost`. Caddy issues a certificate from its own internal
# CA, so no public DNS or open ports are needed. Browsers show a warning until that CA is
# trusted locally — see README.md in this directory.
#
# Do not use a *.localhost subdomain such as novocore.localhost here unless you add a hosts
# entry for it. Browsers resolve *.localhost internally, but Windows' resolver does not, so
# curl, health checks and scripts would all fail against it while the browser looked fine.
#
# Production: set the real hostname. Caddy then obtains a publicly trusted certificate over
# ACME automatically, which requires that this hostname resolves to the host and that ports
# 80 and 443 are reachable from the internet.
NOVOCORE_SITE_ADDRESS=localhost
