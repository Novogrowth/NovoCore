{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    // "node" is here for the tests, which read the OpenAPI spec and the stylesheet off disk. The
    // application code itself never touches a Node API — `npm run build` would fail if it did.
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom", "node"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"]
    },
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,

    /* Linting.
     *
     * `strict` was off, which is the single change here that matters: without it every wire value
     * that can be absent — and under Jackson's non_null inclusion almost all of them can — reads as
     * present, and a redacted field becomes a runtime crash instead of a compile error.
     *
     * `noUncheckedIndexedAccess` is on for the same reason one step further: `items[0]` on an empty
     * list is `undefined`, and a table that pages past its data must be made to say so. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
