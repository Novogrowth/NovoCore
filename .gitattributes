# Line endings are normalised to LF in the repository by default. What matters here is the
# working-copy ending for files that a shell or a container actually executes.

* text=auto

# Must be LF. `mvnw` is run by /bin/sh in CI and inside the Docker build; with CRLF endings
# the shell fails with an unhelpful "bad interpreter" or "not found" error. Same for the
# Caddy config and the Dockerfile, which are read inside Linux containers.
mvnw text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
Caddyfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# The generated API contract. Byte-compared against a freshly generated document on every build
# (OpenApiSpecIT), so its working-copy endings must not depend on which machine checked it out —
# a CRLF working copy on Windows against an LF one on the CI runner would report a contract change
# that had not happened. The generator normalises its output to LF for the same reason; this makes
# the checkout agree rather than relying on the reader to normalise.
docs/api/openapi.json text eol=lf

# Must be CRLF: interpreted by cmd.exe, which mishandles LF-only batch files.
*.cmd text eol=crlf
*.bat text eol=crlf

# Treat as binary so git never tries to normalise or diff them as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.jar binary
