<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>gr.novotrade.novocore</groupId>
    <artifactId>novocore-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>novocore-core</artifactId>
  <name>NovoCore :: Core</name>
  <description>
    The core implementation: JPA entities, repositories, service implementations, the
    journal posting engine, Flyway migrations, and the REST controllers that serve the
    frontend. Nothing outside this module may depend on it except `app`.
  </description>

  <dependencies>
    <dependency>
      <groupId>gr.novotrade.novocore</groupId>
      <artifactId>novocore-core-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!--
      Flyway owns the schema from the first commit. Hibernate never generates DDL
      (ddl-auto: validate) because the debits=credits invariant is enforced by a database
      constraint trigger that Hibernate cannot express — see CLAUDE.md rule 6.

      Use spring-boot-starter-flyway, NOT a bare org.flywaydb:flyway-core. Spring Boot 4 split
      its autoconfiguration into per-technology modules, so flyway-core alone puts Flyway on
      the classpath with nothing to trigger it: the application starts, no migration runs, and
      the only symptom is a missing schema. This was caught by the smoke test asserting the
      history table exists.

      flyway-database-postgresql stays explicit: Flyway 10+ moved per-database support into
      separate modules and the starter does not pull ours in.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Tests run against real PostgreSQL, never H2. An in-memory stand-in cannot execute
      the constraint triggers that make the ledger invariants structural, so passing tests
      against H2 would prove nothing about the guarantee that actually matters.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Publish this module's test classes as a test-jar so the PostgreSQL Testcontainers
        harness is defined exactly once and reused by every other module that needs a real
        database. The alternative — each module declaring its own container bean — is the
        kind of small duplication that CLAUDE.md's code-quality section warns accumulates
        unnoticed.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>test-jar</id>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
