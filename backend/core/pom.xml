<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>gr.novotrade.novocore</groupId>
    <artifactId>novocore-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>novocore-core</artifactId>
  <name>NovoCore :: Core</name>
  <description>
    The core implementation: JPA entities, repositories, service implementations, the
    journal posting engine, Flyway migrations, and the REST controllers that serve the
    frontend. Nothing outside this module may depend on it except `app`.
  </description>

  <dependencies>
    <dependency>
      <groupId>gr.novotrade.novocore</groupId>
      <artifactId>novocore-core-api</artifactId>
    </dependency>
    <!--
      The property-based testing harness (gr.novotrade.novocore.core.api.testsupport), so FIFO's
      properties are written with the same generators and the same shrinking as Money's. Test scope
      only — this is a test-jar, and nothing in main sources may reach it.
    -->
    <dependency>
      <groupId>gr.novotrade.novocore</groupId>
      <artifactId>novocore-core-api</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!--
      Email sending. CLAUDE.md names this a shared *core* service — configured once via
      Settings and reached through one interface — so the SMTP client belongs here rather
      than in an adapter: it is not translating an external system's model into ours, it is
      a transport the core owns.

      Confined to gr.novotrade.novocore.core.email by an ArchUnit rule, so a module cannot
      grow its own mail session and recreate the scattered-credentials problem this whole
      arrangement exists to prevent.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>

    <!--
      Password hashing only — deliberately NOT spring-boot-starter-security.

      The core hashes and verifies passwords itself so that a hash never crosses its boundary
      (see UserService.authenticate). That needs DelegatingPasswordEncoder and nothing else.
      Pulling the full starter in here would also drag the servlet filter chain, method
      security and the authentication plumbing into the core, which belong in `app` as
      cross-cutting configuration. spring-security-crypto has no Spring context dependency at
      all — it is a library of hashing algorithms.
    -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>

    <!--
      Flyway owns the schema from the first commit. Hibernate never generates DDL
      (ddl-auto: validate) because the debits=credits invariant is enforced by a database
      constraint trigger that Hibernate cannot express — see CLAUDE.md rule 6.

      Use spring-boot-starter-flyway, NOT a bare org.flywaydb:flyway-core. Spring Boot 4 split
      its autoconfiguration into per-technology modules, so flyway-core alone puts Flyway on
      the classpath with nothing to trigger it: the application starts, no migration runs, and
      the only symptom is a missing schema. This was caught by the smoke test asserting the
      history table exists.

      flyway-database-postgresql stays explicit: Flyway 10+ moved per-database support into
      separate modules and the starter does not pull ours in.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Tests run against real PostgreSQL, never H2. An in-memory stand-in cannot execute
      the constraint triggers that make the ledger invariants structural, so passing tests
      against H2 would prove nothing about the guarantee that actually matters.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      An in-process SMTP server, so the email service is tested by actually sending mail and
      reading the received message back — including the Reply-To header, which is the one
      thing about this feature that has no other way of being checked.

      In-process rather than a Testcontainers mail server: this needs no Docker, so the
      composition and header tests run under `mvn test` alongside everything else fast.
    -->
    <dependency>
      <groupId>com.icegreen</groupId>
      <artifactId>greenmail</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Publish this module's test classes as a test-jar so the PostgreSQL Testcontainers
        harness is defined exactly once and reused by every other module that needs a real
        database. The alternative — each module declaring its own container bean — is the
        kind of small duplication that CLAUDE.md's code-quality section warns accumulates
        unnoticed.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>test-jar</id>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
