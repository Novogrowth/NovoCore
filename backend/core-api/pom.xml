<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>gr.novotrade.novocore</groupId>
    <artifactId>novocore-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>novocore-core-api</artifactId>
  <name>NovoCore :: Core API</name>
  <description>
    The core's published surface: service interfaces, DTOs, value objects and enums.
    This is the ONLY NovoCore artifact that adapters and modules are allowed to depend on.

    Keep this module free of persistence and framework types. It has no compile
    dependencies on purpose — if something here needs Spring or JPA, it belongs in the
    `core` module instead, and an architecture test enforces that.
  </description>

  <dependencies>
    <!--
      Test-scope only, and deliberately NOT spring-boot-starter-test: pulling Spring in
      even for tests would make it easy for a framework type to drift into this module's
      API by way of a test helper.
    -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
