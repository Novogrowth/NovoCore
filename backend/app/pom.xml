<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>gr.novotrade.novocore</groupId>
    <artifactId>novocore-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>novocore-app</artifactId>
  <name>NovoCore :: Application</name>
  <description>
    The deployable Spring Boot application: entry point, cross-cutting configuration, and
    the place where core, adapters and modules are wired together. Business logic does not
    belong here.
  </description>

  <dependencies>
    <dependency>
      <groupId>gr.novotrade.novocore</groupId>
      <artifactId>novocore-core</artifactId>
    </dependency>

    <!-- Health and readiness endpoints for the reverse proxy and the container runtime. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!--
      The authentication filter chain and session management live here, not in core: they are
      cross-cutting configuration, which is what this module is for.

      Note the asymmetry with `core`, which takes only spring-security-crypto. The core hashes
      and verifies passwords; this module decides how a request proves who it is. Neither needs
      the other's half.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      TestRestTemplate. Spring Boot 4 split test support into per-technology modules, so this is
      no longer part of spring-boot-starter-test as it was in 3.x, and it is no longer supplied
      automatically by webEnvironment=RANDOM_PORT — the test class needs
      @AutoConfigureTestRestTemplate as well.

      Note this is spring-boot-resttestclient, NOT the similarly named spring-boot-restclient-test,
      which is for mocking a RestTemplate's outbound calls and contains no TestRestTemplate at all.

      Needed rather than MockMvc because the endpoint test asserts the real Set-Cookie header:
      HttpOnly, Secure and SameSite are applied by the servlet container, and MockMvc has none, so
      it could not tell whether the session cookie is actually hardened.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-resttestclient</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      RestTemplateBuilder, which spring-boot-resttestclient needs at runtime and does not pull in
      itself. Without it the context fails with NoClassDefFoundError rather than a missing-bean
      message, which is a long way from the cause.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-restclient</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The shared PostgreSQL Testcontainers harness, defined once in core's test sources. -->
    <dependency>
      <groupId>gr.novotrade.novocore</groupId>
      <artifactId>novocore-core</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!--
            Publish the executable jar under a classifier so the module's MAIN artifact
            stays an ordinary library jar.

            Without this, `repackage` replaces the main artifact with the executable jar,
            whose classes live under BOOT-INF/classes and are therefore invisible to
            anything depending on this module. That would silently exclude the whole `app`
            module from the ArchUnit suite — rules covering it would pass while checking
            nothing, which is exactly the failure mode ArchUnitSanityTest exists to catch.

            Consequence: the deployable artifact is novocore-app-<version>-exec.jar, and
            docker/Dockerfile refers to that name.
          -->
          <classifier>exec</classifier>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
